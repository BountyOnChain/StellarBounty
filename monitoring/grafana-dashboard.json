{
  "title": "StellarBounty Backend",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (method, route, status_code) (rate(stellar_bounty_http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stellar_bounty_http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Database errors and slow queries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (operation) (rate(stellar_bounty_database_query_errors_total[5m]))"
        },
        {
          "expr": "increase(stellar_bounty_database_slow_queries_total[5m])"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Stellar RPC failures and retries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (operation, retryable) (rate(stellar_bounty_stellar_rpc_failures_total[5m]))"
        },
        {
          "expr": "sum by (operation, retryable) (rate(stellar_bounty_stellar_rpc_retries_total[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active websocket connections",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "stellar_bounty_websocket_connections_active"
        }
      ]
    }
  ]
}
