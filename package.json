{
  "name": "stellar-bounty",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:up": "docker compose up --build",
    "build": "npm run build --workspaces --if-present",
    "install:all": "npm install",
    "release:check": "npm run build --workspaces --if-present && git diff --check",
    "version": "npm run release:check",
    "adr:new": "node scripts/adr-scaffold.js"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "overrides": {
    "axios": "^1.18.0",
    "brace-expansion": "^2.1.2",
    "form-data": "^4.0.6",
    "glob": "^10.4.5",
    "js-yaml@4": "^4.2.0",
    "js-yaml@3": "^3.14.2",
    "lodash": "^4.17.21",
    "multer": "^2.1.2",
    "picomatch@4": "^4.0.4",
    "postcss": "^8.5.10",
    "sanitize-html": "2.13.0",
    "sharp": "^0.35.0",
    "tmp": "^0.2.6"
  }
}
